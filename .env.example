# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Your ShotQuality login. Optional if you prefer `cbbsq login --headed` (manual login in a
# real browser window; the session is then remembered in .auth/profile).
SQ_EMAIL=you@example.com
SQ_PASSWORD=change-me

# REQUIRED: the CBB ScoreCenter address. Open it in your browser and copy the URL bar.
# If the URL contains the date (check after picking another date in the calendar),
# replace the date with a placeholder so backfills jump straight to each day:
#   {date}            -> 2026-01-10
#   {date:%Y%m%d}     -> 20260110
#   {date:%m-%d-%Y}   -> 01-10-2026
# `cbbsq probe` will suggest the right value for you.
SQ_SCORECENTER_URL=https://shotquality.com/PASTE-THE-SCORECENTER-PATH-HERE

# Optional: login page, if visiting the ScoreCenter while logged out doesn't show a login form.
# SQ_LOGIN_URL=https://shotquality.com/login

# How to switch dates: auto (default) | url (needs {date} above) | ui (use the date picker)
# SQ_DATE_MODE=auto

# Optional storage locations and politeness delay between dates (seconds)
# CBBSQ_DB=data/cbbsq.sqlite
# CBBSQ_RAW_DIR=data/raw
# CBBSQ_PROFILE_DIR=.auth/profile
# CBBSQ_DELAY_SECONDS=4

# Use your installed Google Chrome instead of Playwright's Chromium (sometimes helps with logins)
# CBBSQ_BROWSER_CHANNEL=chrome
